# Public app settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Arc Testnet settings
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_COMMITPASS_CONTRACT_ADDRESS=0x66592bDB161b2C68ceFB4133Cfa0dB08eD2Ff791
# Public address only. This enables the fixed CommitPass demo verifier in the UI.
NEXT_PUBLIC_COMMITPASS_DEMO_ATTESTOR_ADDRESS=

# Deployment only. Never commit a real private key.
ARC_RPC_URL=https://rpc.testnet.arc.network
DEPLOYER_PRIVATE_KEY=
ARBITER_ADDRESS=0x31B7Be1e0d05BA7866f03a4Dc6244e34D9191e29

# V3 source verification after deployment
COMMITPASS_V3_CONTRACT_ADDRESS=0x66592bDB161b2C68ceFB4133Cfa0dB08eD2Ff791

# Platform attendance attestation signing
# Keep the private key only in .env or a managed secret store.
PLATFORM_ATTESTOR_PRIVATE_KEY=
ATTESTATION_RESERVATION_ID=
ATTESTATION_PARTICIPANT=
ATTESTATION_VALID_UNTIL=

# Policy-bound digital session attestation script
SESSION_RECEIPT_PATH=
ATTESTATION_TTL_SECONDS=300
